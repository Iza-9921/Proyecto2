<?xml version="1.0" encoding="utf-8"?>
<!-- Solo para desarrollo: 10.0.2.2 es el alias del emulador hacia el host; 192.168.100.19 es la IP
     de la PC en la red Wi-Fi local, usada por un celular físico en la misma red. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">192.168.100.19</domain>
    </domain-config>
</network-security-config>
